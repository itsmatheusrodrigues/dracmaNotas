]


def obter_mapa_colunas(ws) -> dict:
    colunas = {}

    for celula in ws[1]:
        if celula.value is not None:
            colunas[str(celula.value).strip()] = celula.column

    return colunas


def obter_linhas_com_documentos() -> list[int]:
    """
    Retorna todas as linhas que possuem valor na coluna
    'Nome do Documento'.

    Exemplo:
        linha 2 -> F10.pdf
        linha 3 -> F11.pdf
        linha 4 -> F12.pdf
    """

    if not ARQUIVO_EXCEL.exists():
        raise FileNotFoundError(
            f"Arquivo Excel não encontrado: {ARQUIVO_EXCEL}"
        )

    wb = load_workbook(
        ARQUIVO_EXCEL,
        data_only=True,
    )

    if ABA_EXCEL not in wb.sheetnames:
        wb.close()
        raise ValueError(
            f"A aba '{ABA_EXCEL}' não existe no arquivo."
        )

    ws = wb[ABA_EXCEL]
    colunas = obter_mapa_colunas(ws)

    if "Nome do Documento" not in colunas:
        wb.close()
        raise ValueError(
            "A coluna 'Nome do Documento' não existe no Excel."
        )

    coluna_nome = colunas["Nome do Documento"]

    linhas = []

    for numero_linha in range(2, ws.max_row + 1):
        valor = ws.cell(
            row=numero_linha,
            column=coluna_nome,
        ).value

        if valor is not None and str(valor).strip():
            linhas.append(numero_linha)

    wb.close()

    return linhas


def ler_documento_excel(numero_linha: int) -> dict:
    if not ARQUIVO_EXCEL.exists():
        raise FileNotFoundError(
            f"Arquivo Excel não encontrado: {ARQUIVO_EXCEL}"
        )

    wb = load_workbook(
        ARQUIVO_EXCEL,
        data_only=True,
    )

    if ABA_EXCEL not in wb.sheetnames:
        wb.close()
        raise ValueError(
            f"A aba '{ABA_EXCEL}' não existe no arquivo."
        )

    ws = wb[ABA_EXCEL]
    colunas = obter_mapa_colunas(ws)

    faltando = [
        nome
        for nome in COLUNAS_NECESSARIAS
        if nome not in colunas
    ]

    if faltando:
        wb.close()
        raise ValueError(
            "Faltam colunas no Excel: "
            + ", ".join(faltando)
        )

    dados = {}

    for nome_coluna in COLUNAS_NECESSARIAS:
        dados[nome_coluna] = ws.cell(
            row=numero_linha,
            column=colunas[nome_coluna],
        ).value

    wb.close()

    if not dados["Nome do Documento"]:
        raise ValueError(
            f"A linha {numero_linha} não possui Nome do Documento."
        )

    return dados


