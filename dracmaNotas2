def processar_documento(
    page,
    numero_linha: int,
    indice_atual: int,
    total_documentos: int,
):
    """
    Executa TODO o fluxo para uma linha do Excel.
    Ao final, clica em XPATH_ENVIAR.
    """

    dados = ler_documento_excel(
        numero_linha=numero_linha
    )

    nome_documento = texto_seguro(
        dados["Nome do Documento"]
    )

    tipo_documento = texto_seguro(
        dados["Tipo de Documento"]
    )

    emitente = texto_seguro(
        dados["Emitente"]
    )

    data_emissao = formatar_data_para_dracma(
        dados["Data de Emissão"]
    )

    numero = texto_seguro(
        dados["Número"]
    )

    valor = formatar_valor_para_dracma(
        dados["Valor"]
    )

    finalidade = texto_seguro(
        dados["Finalidade"]
    )

    categoria = texto_seguro(
        dados["Categorias de Gasto"]
    )

    centro_custo = texto_seguro(
        dados["Centros de Custo"]
    )

    forma_pagamento = texto_seguro(
        dados["Forma de Pagamento"]
    )

    codigo_pagamento = texto_seguro(
        dados["Campo de Pagamento"]
    )

    print()
    print("=" * 70)
    print(
        f"DOCUMENTO {indice_atual}/{total_documentos} "
        f"- LINHA {numero_linha}"
    )
    print("=" * 70)
    print(f"Documento: {nome_documento}")
    print(f"Tipo de Documento: {tipo_documento}")
    print(f"Emitente: {emitente}")
    print(f"Data de Emissão: {data_emissao}")
    print(f"Número: {numero}")
    print(f"Valor: {valor}")
    print(f"Finalidade: {finalidade}")
    print(f"Categoria de Gasto: {categoria}")
    print(f"Centro de Custo: {centro_custo}")
    print(f"Forma de Pagamento: {forma_pagamento}")
    print(f"Campo de Pagamento: {codigo_pagamento}")
    print("=" * 70)

    # ========================================================
    # ABRIR/REABRIR FORMULÁRIO PARA ESTE DOCUMENTO
    # ========================================================

    etapa("ABRIR FORMULÁRIO")

    page.goto(
        URL_DRACMA,
        wait_until="domcontentloaded",
        timeout=60000,
    )

    page.locator(
        XPATH_TIPO_DOCUMENTO
    ).wait_for(
        state="visible",
        timeout=300000,
    )

    print("[OK] Formulário carregado.")

    # ========================================================
    # DADOS PRINCIPAIS
    # ========================================================

    etapa("DADOS PRINCIPAIS")

    preencher_dropdown(
        page,
        page.locator(XPATH_TIPO_DOCUMENTO),
        tipo_documento,
        "Tipo de Documento",
    )

    preencher_dropdown(
        page,
        page.locator(XPATH_EMITENTE),
        emitente,
        "Emitente",
    )

    preencher_campo(
        page,
        page.locator(XPATH_DATA_EMISSAO),
        data_emissao,
        "Data de Emissão",
    )

    preencher_campo(
        page,
        page.locator(XPATH_NUMERO),
        numero,
        "Número",
    )

    preencher_campo(
        page,
        page.locator(XPATH_VALOR),
        valor,
        "Valor",
    )

    preencher_campo(
        page,
        page.locator(XPATH_FINALIDADE),
        finalidade,
        "Finalidade",
    )

    # ========================================================
    # ANEXO
    # ========================================================
    page.wait_for_timeout(5000)
    etapa("ANEXO")

    anexar_pdf(
        page,
        nome_documento,
    )

    # ========================================================
    # SALVAR DADOS PRINCIPAIS
    # ========================================================
    page.wait_for_timeout(5000)

    etapa("SALVAR DADOS PRINCIPAIS")

    page.wait_for_timeout(5000)

    clicar(
        page,
        page.locator(XPATH_SALVAR),
        "Salvar dados principais",
    )

    print(
        "[AGUARDANDO] 5 segundos para o Dracma "
        "carregar Categoria/Centro de Custo..."
    )

    page.wait_for_timeout(5000)

    print("[OK] Espera concluída.")

    # ========================================================
    # CRIAR CATEGORIA + CENTRO DE CUSTO
    # ========================================================

    etapa("CRIAR CATEGORIA E CENTRO DE CUSTO")

    # Mantive a espera que você colocou no código que funcionou.
    page.wait_for_timeout(5000)

    try:
        clicar(
            page,
            page.locator(
                XPATH_CRIAR_CATEGORIA_E_CENTRO_CUSTO
            ),
            "Criar Categoria/Centro de Custo",
            timeout=3000,
        )

        print(
            "[AGUARDANDO] 1 segundo para os campos "
            "de Categoria/Centro de Custo aparecerem..."
        )

        page.wait_for_timeout(3000)

    except PlaywrightTimeoutError:
        print(
            "[AVISO] Não foi possível clicar em "
            "XPATH_CRIAR_CATEGORIA_E_CENTRO_CUSTO."
        )
        print(
            "[CONTINUANDO] Pulando diretamente para XPATH_CATEGORIA."
        )

    # ========================================================
    # CATEGORIA
    # ========================================================

    etapa("CATEGORIA DE GASTO")
    page.wait_for_timeout(3000)
    preencher_dropdown(
        page=page,
        locator=page.locator(
            XPATH_CATEGORIA
        ),
        valor=categoria,
        nome_campo="Categoria de Gasto",
    )

    # ========================================================
    # CENTRO DE CUSTO
    # ========================================================

    etapa("CENTRO DE CUSTO")
    page.wait_for_timeout(3000)
    preencher_dropdown(
        page=page,
        locator=page.locator(
            XPATH_CENTRO_CUSTO
        ),
        valor=centro_custo,
        nome_campo="Centro de Custo",
    )

    # ========================================================
    # SALVAR CATEGORIA + CENTRO DE CUSTO
    # ========================================================
    
    etapa("SALVAR CATEGORIA E CENTRO DE CUSTO")

    clicar(
        page,
        page.locator(
            XPATH_SALVAR_CATEGORIA_E_CENTRO_CUSTO
        ),
        "Salvar Categoria/Centro de Custo",
    )

    print(
        "[OK] Categoria e Centro de Custo salvos."
    )

    page.wait_for_timeout(1000)

    # ========================================================
    # PAGAMENTO
    # ========================================================

    etapa("PAGAMENTO")

    preencher_dropdown(
        page=page,
        locator=page.locator(
            XPATH_FORMA_PAGAMENTO
        ),
        valor=forma_pagamento,
        nome_campo="Forma de Pagamento",
    )

    preencher_campo(
        page=page,
        locator=page.locator(
            XPATH_CODIGO_PAGAMENTO
        ),
        valor=codigo_pagamento,
        nome_campo="Campo de Pagamento",
        pressionar_enter=True,
    )

    # ========================================================
    # SALVAR PAGAMENTO
    # ========================================================

    etapa("SALVAR PAGAMENTO")

    clicar(
        page,
        page.locator(
            XPATH_SALVAR_PAGAMENTO
        ),
        "Salvar Pagamento",
    )

    page.wait_for_timeout(1000)

    # ========================================================
    # ENVIAR DOCUMENTO
    # ========================================================

    etapa("ENVIAR DOCUMENTO")

    clicar(
        page,
        page.locator(
            XPATH_ENVIAR
        ),
        "Enviar Documento",
    )

    print(
        f"[OK] Documento enviado: {nome_documento}"
    )

    # Dá tempo para o Dracma concluir a ação antes do próximo loop.
    page.wait_for_timeout(2000)


# ============================================================
# AUTOMAÇÃO PRINCIPAL
# ============================================================

def run(playwright: Playwright) -> None:
    context = None

    try:
        # ====================================================
        # DESCOBRIR TODOS OS DOCUMENTOS DO EXCEL
        # ====================================================

        linhas_documentos = obter_linhas_com_documentos()

        if not linhas_documentos:
            print(
                "[AVISO] Nenhum documento encontrado no Excel."
            )
            return

        total_documentos = len(
            linhas_documentos
        )

        print()
        print("=" * 70)
        print("DRACMA - PROCESSAMENTO EM LOTE")
        print("=" * 70)
        print(
            f"Total de documentos encontrados: "
            f"{total_documentos}"
        )
        print(
            f"Linhas do Excel: {linhas_documentos}"
        )
        print("=" * 70)

        # ====================================================
        # CACHE
        # ====================================================

        PASTA_CACHE.mkdir(
            parents=True,
            exist_ok=True,
        )

        # ====================================================
        # NAVEGADOR COM CACHE
        # ====================================================

        context = playwright.chromium.launch_persistent_context(
            user_data_dir=str(PASTA_CACHE),
            headless=False,
            no_viewport=True,
            args=[
                "--window-size=1920,1080",
                "--window-position=0,0",
            ],
        )

        if context.pages:
            page = context.pages[0]
        else:
            page = context.new_page()

        # ====================================================
        # LOOP - TODOS OS DOCUMENTOS
        # ====================================================

        enviados = 0

        for indice, numero_linha in enumerate(
            linhas_documentos,
            start=1,
        ):
            try:
                processar_documento(
                    page=page,
                    numero_linha=numero_linha,
                    indice_atual=indice,
                    total_documentos=total_documentos,
                )

                enviados += 1

                print()
                print(
                    f"[PROGRESSO] {enviados}/{total_documentos} "
                    "documento(s) enviado(s)."
                )

                # Se ainda existe outro documento,
                # o loop simplesmente volta ao início.
                if indice < total_documentos:
                    print()
                    print(
                        "[PRÓXIMO] Preparando próximo documento do Excel..."
                    )

                    page.wait_for_timeout(1000)

            except PlaywrightTimeoutError as erro:
                print()
                print("=" * 70)
                print(
                    f"[ERRO] TIMEOUT NO DOCUMENTO DA LINHA {numero_linha}"
                )
                print("=" * 70)
                print(erro)
                print()
                print(
                    "[PARANDO] O lote foi interrompido para evitar "
                    "que um documento parcialmente preenchido gere "
                    "lançamentos incorretos."
                )
                print("=" * 70)

                break

            except Exception as erro:
                print()
                print("=" * 70)
                print(
                    f"[ERRO] DOCUMENTO DA LINHA {numero_linha}"
                )
                print("=" * 70)
                print(
                    f"Tipo do erro: {type(erro).__name__}"
                )
                print(
                    f"Mensagem: {erro}"
                )
                print()
                print(
                    "[PARANDO] O lote foi interrompido para evitar "
                    "lançamentos incorretos."
                )
                print("=" * 70)

                break

        # ====================================================
        # RESUMO
        # ====================================================

        print()
        print("=" * 70)
        print("RESUMO DO PROCESSAMENTO")
        print("=" * 70)
        print(
            f"Documentos encontrados no Excel: "
            f"{total_documentos}"
        )
        print(
            f"Documentos enviados nesta execução: "
            f"{enviados}"
        )

        if enviados == total_documentos:
            print(
                "[OK] Todos os documentos do Excel foram processados."
            )
        else:
            print(
                "[AVISO] O processamento terminou antes de concluir "
                "todos os documentos."
            )

        print("=" * 70)

    except Exception as erro:
        print()
        print("=" * 70)
        print("[ERRO] A AUTOMAÇÃO NÃO PÔDE SER INICIADA")
        print("=" * 70)
        print(
            f"Tipo do erro: {type(erro).__name__}"
        )
        print(
            f"Mensagem: {erro}"
        )
        print("=" * 70)

    finally:
        if context is not None:
            manter_navegador_aberto(
                context
            )


